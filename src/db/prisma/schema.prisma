// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  previewFeatures  = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator zod {
  provider = "zod-prisma-types"
  useMultipleFiles                 = false // default is false
  writeBarrelFiles                 = false // default is true
  createInputTypes                 = false // default is true
  createModelTypes                 = true // default is true
  addInputTypeValidation           = false // default is true
  addIncludeType                   = false // default is true
  addSelectType                    = false // default is true
  validateWhereUniqueInput         = true // default is true
  createOptionalDefaultValuesTypes = true // default is false
  createRelationValuesTypes        = true // default is false
  createPartialTypes               = true // default is false
  useDefaultValidators             = true // default is true
  coerceDate                       = true // default is true
  writeNullishInModelTypes         = false // default is false
}

model Event {
  // supabase-js 経由の INSERT でも採番されるよう DB 側で生成する
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// @zod.string.min(1, { message: "タイトルは必須です" }).max(100, { message: "100文字以内です" })
  title String
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt DateTime @map("ends_at") @db.Timestamptz(3)
  // 終日予定は開始=その日の00:00(JST)、終了=最終日の翌日00:00(JST)
  allDay Boolean @default(false) @map("all_day")
  // 6色から選択（値の検証は zod 側で行う）
  color String @default("blue")
  /// @zod.string.max(1000, { message: "1000文字以内です" })
  memo String @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  // 表示範囲との重なり検索（starts_at < 範囲の終わり AND ends_at > 範囲の始まり）用
  @@index([startsAt, endsAt])
  @@map("events")
}
