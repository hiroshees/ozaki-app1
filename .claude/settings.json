{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run lint)",
      "Bash(npm run test *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc --noEmit)"
    ],
    "ask": [
      "Bash(supabase db push *)",
      "Bash(supabase db reset *)",
      "Bash(supabase migration repair *)",
      "Bash(vercel --prod *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)"
    ]
  }
}
